#!/bin/sh
# Remove the package-managed virtual environment. User data under
# ~/.local/share is intentionally left untouched.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -rf /opt/forgemesh/venv
    rm -f /opt/forgemesh/app/.venv
    rmdir /opt/forgemesh 2>/dev/null || true
fi

#DEBHELPER#
