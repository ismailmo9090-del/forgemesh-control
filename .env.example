# ForgeMesh Browser configuration (all variables are optional).
# Copy to .env and edit. Never commit real secrets.

# --- Runtime ---------------------------------------------------------------
# FMB_DATA_DIR=/home/you/.local/share/forgemesh-browser
# FMB_HEADLESS=true
FMB_DEFAULT_PROFILE=primary
FMB_VIEWPORT_WIDTH=1440
FMB_VIEWPORT_HEIGHT=900
FMB_MAX_CONTEXTS=3
FMB_NAVIGATION_TIMEOUT_MS=45000
FMB_ACTION_TIMEOUT_MS=15000
FMB_DOWNLOAD_MAX_BYTES=209715200
FMB_UPLOAD_MAX_BYTES=104857600

# Browser channel: "chrome" uses the system Google Chrome, leave empty to use
# the Playwright-managed Chromium. "chromium" forces the bundled build.
FMB_BROWSER_CHANNEL=chrome
# Hide automation markers so Google/OAuth accepts the browser for manual login.
FMB_BROWSER_STEALTH=true

# --- Identity vault --------------------------------------------------------
# The vault is encrypted with a random 256-bit key file by default
# (~/.config/forgemesh-browser/vault.key, mode 0600). Set a master passphrase
# instead *before* the first `fmb identity password`. The CLI and the daemon
# must see the same value.
# FMB_VAULT_PASSPHRASE=change-me
# Seconds to wait for each identity × provider sign-in to be confirmed.
FMB_IDENTITY_LOGIN_TIMEOUT_SECONDS=180
# Pause between matrix cells so providers do not see a burst of logins.
FMB_IDENTITY_LOGIN_DELAY_SECONDS=1.5

# --- Local API daemon ------------------------------------------------------
FMB_API_HOST=127.0.0.1
FMB_API_PORT=8765
# Remote access is disabled by default and requires an explicit token.
# FMB_API_REMOTE=false

# --- AI --------------------------------------------------------------------
# Local Ollama (no API key required)
FMB_OLLAMA_HOST=http://127.0.0.1:11434
FMB_OLLAMA_MODEL=llama3.1
FMB_AI_PROVIDER=ollama
# Optional OpenAI-compatible endpoint (used only when explicitly selected)
# FMB_OPENAI_BASE_URL=https://api.openai.com/v1
# FMB_OPENAI_API_KEY=sk-...
# FMB_OPENAI_MODEL=gpt-4o-mini

# --- OCR -------------------------------------------------------------------
FMB_OCR_LANG=eng
